    <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
      <left_joint>left_rear_wheel_joint</left_joint>
      <right_joint>right_rear_wheel_joint</right_joint>
      <left_steering_joint>left_steering_hinge_joint</left_steering_joint>
      <right_steering_joint>right_steering_hinge_joint</right_steering_joint>
      <wheel_separation>0.2</wheel_separation>
      <kingpin_width>0.2</kingpin_width>
      <wheel_base>0.325</wheel_base>
      <wheel_radius>0.05</wheel_radius>
      <steering_limit>0.6</steering_limit>
      <steer_p_gain>10</steer_p_gain>
      <topic>/cmd_vel</topic>
      <!-- Wheel odometry is unused; /odom below reports the ground-truth pose. -->
      <odom_topic>/model/racecar/wheel_odometry</odom_topic>
      <odom_publish_frequency>1</odom_publish_frequency>
      <min_velocity>-2</min_velocity>
      <max_velocity>2</max_velocity>
    </plugin>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
