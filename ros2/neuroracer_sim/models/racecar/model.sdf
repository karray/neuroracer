      </visual>
      <sensor name="hokuyo_sensor" type="gpu_lidar">
        <visualize>false</visualize>
        <!-- Sensors fire once per 0.1 s environment step, exactly at its end. -->
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>1081</samples>
              <resolution>1</resolution>
              <min_angle>-2.35619</min_angle>
              <max_angle>2.35619</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.1</min>
            <max>10</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <mean>0</mean>
            <stddev>0.01</stddev>
            <type>gaussian</type>
          </noise>
        </lidar>
        <pose>0.265 0 0.125 0 -0 0</pose>
        <always_on>true</always_on>
        <topic>/scan</topic>
      </sensor>
      <gravity>1</gravity>
      <sensor name="zed_camera_left_sensor" type="camera">
        <update_rate>10</update_rate>
        <camera name="zed_camera_left_camera">
          <horizontal_fov>0.870922</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>300</far>
          </clip>
          <noise>
            <mean>0</mean>
            <stddev>0.007</stddev>
            <type>gaussian</type>
          </noise>
        </camera>
        <pose>0.39 0.06 0.09 0 -0 0</pose>
        <always_on>true</always_on>
        <topic>/camera/image_raw</topic>
      </sensor>
