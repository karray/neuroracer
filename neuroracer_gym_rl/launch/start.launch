<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <arg name="always_explore" default="false" />
    <arg name="agent" />

    <!-- Launch the training system -->
    
    <node pkg="neuroracer_gym_rl" name="neuroracer_gym_rl" exec="training.py" output="screen"
          args="$(var agent) --always-explore $(var always_explore)"/>
</launch>
